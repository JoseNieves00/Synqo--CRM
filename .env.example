# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-never-expose-to-client

# Meta WhatsApp Cloud API (v20+)
META_APP_SECRET=your_meta_app_secret_from_developers_portal
META_WEBHOOK_VERIFY_TOKEN=your_custom_secure_verify_token_here

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-...

# Application Encryption Key (AES-256-GCM - exactly 32 bytes or 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upstash Redis (Rate Limiting & Wallet Exhaustion Mitigation)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Resend API (Human Handoff & Booking Email Notifications)
RESEND_API_KEY=re_123456789
SUPABASE_WEBHOOK_SECRET=your_secret_for_supabase_db_webhooks

# App URL
NEXT_PUBLIC_APP_URL=https://synqo.dev

