# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-publishable
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-secret-never-expose

# Meta WhatsApp Cloud API (v20+)
META_APP_SECRET=your_meta_app_secret_from_developers_portal
META_WEBHOOK_VERIFY_TOKEN=your_custom_secure_verify_token_here
NEXT_PUBLIC_META_APP_ID=your_meta_app_id_for_embedded_signup
NEXT_PUBLIC_META_CONFIG_ID=your_meta_embedded_signup_configuration_id

# OpenAI API Configuration
OPENAI_API_KEY=sk-proj-...

# Google AI Studio / Gemini API Configuration (Modelos Gemini 2.0 Flash / 1.5 Flash con Failover a OpenAI)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash

# Super Admin Principal Email
SUPER_ADMIN_EMAIL=admin@synqo.dev

# Cron Security Secret (Vercel Cron / External Trigger for /api/cron/appointment-reminders)
CRON_SECRET=your_secure_cron_secret_here

# Application Encryption Key (AES-256-GCM - exactly 32 bytes or 64 hex characters)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Upstash Redis (Rate Limiting & Wallet Exhaustion Mitigation)
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token

# Resend API (Human Handoff & Booking Email Notifications)
RESEND_API_KEY=re_123456789
SUPABASE_WEBHOOK_SECRET=your_secret_for_supabase_db_webhooks

# Google Calendar & Google Meet OAuth 2.0 (Vinculación con 1 Clic)
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_oauth_client_secret

# App URL
NEXT_PUBLIC_APP_URL=https://synqo.dev

# Evolution API (WhatsApp VPS Engine)
EVOLUTION_API_URL=http://your-vps-ip:8080
NEXT_PUBLIC_EVOLUTION_API_URL=http://your-vps-ip:8080
EVOLUTION_API_KEY=your_secure_evolution_api_key_here

